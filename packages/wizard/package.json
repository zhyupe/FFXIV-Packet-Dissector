{
  "name": "wizard",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./core": {
      "import": "./dist/core.mjs",
      "types": "./dist/core.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown src/index.mts src/core.mts --dts",
    "start": "tsx src/index.mts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.mts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "iconv-lite": "^0.6.3",
    "pcap": "workspace:^"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "@tsconfig/node20": "catalog:"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FFXIV Packet Dissector",
  "version": "0.1.0",
  "identifier": "io.github.zhyupe.ffxiv-packet-dissector",
  "build": {
    "beforeDevCommand": "pnpm prepare:resources && pnpm --filter wizard build && pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm prepare:resources && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FFXIV Packet Dissector",
        "width": 1160,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "resources/": "./"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
